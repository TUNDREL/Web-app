# Copy to .env.local (gitignored) for local work; set the same values on your hosting dashboard.

# Live demo phone number (Vapi). Without it the site shows a fake number and a warning.
NEXT_PUBLIC_DEMO_PHONE="+1 555 555 5555"

# Sample call recording: put the file in /public and reference it, e.g. /sample-call.mp3
NEXT_PUBLIC_SAMPLE_CALL_AUDIO=""

# Optional booking-calendar link used by the Book a demo page
NEXT_PUBLIC_BOOKING_URL=""

# Demo-request form (Web3Forms) and confirmation email (EmailJS)
NEXT_PUBLIC_WEB3FORMS_KEY=""
NEXT_PUBLIC_EMAILJS_SERVICE_ID=""
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=""
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=""

# Emergency section: leave unset until emergency handling is built and tested.
# It always shows in `npm run dev` so you can review it. Set to 1 to show it in production.
# NEXT_PUBLIC_SHOW_EMERGENCY_SECTION=1
